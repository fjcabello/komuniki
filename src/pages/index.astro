---
import Landing from '../layouts/Landing.astro';
import Header from '../components/landing/Header.astro';
import Footer from '../components/landing/Footer.astro';

const audiencias = [
  {
    num: '01',
    titulo: 'Adultos',
    texto:
      'Para el trabajo, para viajar, para preparar un examen o simplemente por curiosidad. Fijamos el objetivo y el ritmo contigo.',
    items: ['Clases individuales', 'Grupos reducidos', 'Por teléfono, 30 minutos', 'Clases virtuales'],
  },
  {
    num: '02',
    titulo: 'Niños y adolescentes',
    texto:
      'Un niño no aprende como un adulto. Por eso sus clases se preparan aparte, con materiales pensados para su edad.',
    items: ['Juegos, canciones e historias', 'Apoyo escolar y refuerzo', 'Temas y métodos adaptados', 'El profesor solo habla en el idioma'],
  },
  {
    num: '03',
    titulo: 'Empresas',
    texto:
      'Francés para tu equipo, y puntualmente inglés. Me desplazo a la empresa y el programa se hace a medida.',
    items: ['Programa según vuestras necesidades', 'En vuestra oficina o en remoto', 'Individual o en grupo', 'Horarios compatibles con el trabajo'],
  },
];

const modalidades = [
  {
    nombre: 'Individual',
    texto: 'Un profesor, un alumno. En tu casa, en tu empresa o donde te venga bien.',
    meta: '1 h · 1 h 30 · 2 h',
  },
  {
    nombre: 'Grupo reducido',
    texto: 'Mismo nivel, más conversación. Sale más económico y se practica el doble.',
    meta: '1 h · 1 h 30 · 2 h',
  },
  {
    nombre: 'Online',
    texto: 'Videollamada con la misma preparación que una clase presencial.',
    meta: '30 min · 1 h',
  },
  {
    nombre: 'Por teléfono',
    texto: 'Clases cortas y frecuentes. Lo que mejor funciona cuando no hay tiempo.',
    meta: '30 min',
  },
  {
    nombre: 'Apoyo escolar',
    texto: 'Refuerzo del idioma del colegio o instituto, con seguimiento del curso.',
    meta: 'A medida',
  },
];

const metodo = [
  {
    num: '01',
    titulo: 'Realidad',
    texto: 'Lo que estudias tiene que ser real y aplicable a tu vida. Si no, se olvida.',
  },
  {
    num: '02',
    titulo: 'Gradiente',
    texto: 'Se avanza en el escalón justo: ni tan fácil que aburra, ni tan alto que frustre.',
  },
  {
    num: '03',
    titulo: 'Palabras',
    texto: 'Ninguna palabra sin entender. Es la razón número uno por la que alguien abandona un idioma.',
  },
];

const opiniones = [
  {
    texto:
      'Confiamos en seguir contando contigo el año que viene. Eres una MAGNÍFICA profesional y es una suerte tenerte como profesora. ¡Feliz verano!',
    autor: 'Miren y Fernando',
    contexto: 'Padres de tres alumnos · Clases individuales',
  },
  {
    texto:
      'Me alegro mucho de que las niñas hayan compartido contigo las clases de refuerzo de francés. Has sido de mucha ayuda para ellas. Bárbara siempre ha estado muy a gusto en tus clases.',
    autor: 'Yolanda',
    contexto: 'Madre de Bárbara · Clases en grupo, 3 alumnas',
  },
  {
    texto: 'Christine Dauzon es muy recomendable. ¡Excelente profesora!',
    autor: 'Alicia',
    contexto: 'Abogada en Repsol · Clases por teléfono',
  },
  {
    texto:
      'Le temps que j’ai passé avec toi a été très utile et j’ai amélioré mon français. Et aussi très amusant. J’ai vraiment apprécié de parler avec toi chaque semaine.',
    autor: 'Luis',
    contexto: 'Clases telefónicas',
    fr: true,
  },
  {
    texto: 'La verdad es que el campamento en Francia les sentó muy bien y las ha motivado mucho. Un gusto que estén tan bien contigo.',
    autor: 'Isabel',
    contexto: 'Madre de tres alumnas · Clases online',
  },
  {
    texto:
      'Merci beaucoup ! C’est un plaisir pour moi aussi de travailler avec vous. Il n’est pas facile de trouver une prof si professionnelle, qui rend l’apprentissage si amusant et intéressant.',
    autor: 'Marta',
    contexto: 'Teléfono y online · Nivel avanzado',
    fr: true,
  },
  {
    texto: 'Muchas gracias Christine por tu atención. Me ha gustado aprender los números contigo y más cosas.',
    autor: 'Ana, 6 años',
    contexto: 'Presencial en un campamento',
  },
  {
    texto:
      'Je te remercie pour ces derniers mois de cours, et je te félicite sincèrement pour un travail exceptionnel : tes cours sont professionnels à la fois que profitables et plaisants.',
    autor: 'Lucía',
    contexto: 'Clases por teléfono · Nivel muy avanzado',
    fr: true,
  },
];
---

<Landing
  title="Komuniki · Clases de francés en Madrid con Christine Dauzon"
  description="Clases de idiomas para adultos, niños y empresas en Madrid. Presencial, online o por teléfono, siempre adaptadas a ti. Christine Dauzon — academia Komuniki."
>
  <Header />

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero" id="inicio">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">Academia Komuniki · Madrid</span>
          <h1 class="display hero__title">Habla otro idioma con <em>confianza</em>.</h1>
          <p class="lede hero__lede">
            Clases de francés para adultos, niños y empresas, con profesora nativa. Presencial en
            Madrid, online o por teléfono — siempre adaptadas a ti.
          </p>

          <div class="hero__actions">
            <a href="#contacto" class="btn btn--primary">Cuéntame qué necesitas</a>
            <a href="#metodo" class="btn btn--ghost">Cómo trabajo</a>
          </div>

          <div class="hero__facts">
            <span><strong>Francés</strong> nativo · Inglés puntual · Refuerzo escolar</span>
            <span><strong>Presencial</strong> · Online · Teléfono</span>
            <span>Getafe, <strong>Madrid</strong></span>
          </div>
        </div>

        <div class="portrait">
          <div class="portrait__frame">
            <!-- TODO(foto): sustituir por un retrato real de Christine, vertical 4:5,
                 luz natural y fondo neutro. Ver notas al final del archivo. -->
            <div class="portrait__placeholder">
              <img src="/images/logo-komuniki.png" alt="" width="258" height="258" />
            </div>
          </div>

          <figure class="portrait__quote">
            <p>«Excelente profesora de francés, sus clases son muy interesantes y amenas.»</p>
            <span>Martín · Abogado en Repsol</span>
          </figure>

          <p class="portrait__note">Reservado para la foto de Christine</p>
        </div>
      </div>
    </section>

    <!-- ============ CLASES ============ -->
    <section class="section" id="clases">
      <div class="wrap">
        <div class="reveal">
          <span class="eyebrow">Clases</span>
          <h2 class="h-section">¿Qué necesitas?</h2>
          <p class="lede" style="margin-top:1rem;">
            Cada alumno llega con un objetivo distinto. El punto de partida siempre es el tuyo.
          </p>
        </div>

        <div class="audience">
          {
            audiencias.map((item) => (
              <article class="audience__item reveal">
                <span class="audience__num">{item.num}</span>
                <h3>{item.titulo}</h3>
                <p>{item.texto}</p>
                <ul class="audience__list">
                  {item.items.map((li) => (
                    <li>{li}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ MODALIDADES ============ -->
    <section class="section section--alt">
      <div class="wrap">
        <div class="reveal">
          <span class="eyebrow">Modalidades</span>
          <h2 class="h-section">Elige cómo quieres darlas</h2>
        </div>

        <div class="modes reveal">
          {
            modalidades.map((mod) => (
              <div class="mode-row">
                <h3>{mod.nombre}</h3>
                <p>{mod.texto}</p>
                <span class="mode-row__meta">{mod.meta}</span>
              </div>
            ))
          }
        </div>

        <div class="modes__foot reveal">
          <p class="muted">¿No sabes cuál te encaja mejor? Lo vemos en dos minutos por teléfono.</p>
          <a href="tel:+34622812442" class="btn btn--ghost">Llamar al 622 81 24 42</a>
        </div>
      </div>
    </section>

    <!-- ============ MÉTODO ============ -->
    <section class="section section--ink" id="metodo">
      <div class="wrap">
        <div class="method__top">
          <div class="reveal">
            <span class="eyebrow">Método</span>
            <p class="method__statement">El objetivo no es <em>saber</em> el idioma. Es poder usarlo.</p>
          </div>
          <div class="method__badge reveal" aria-hidden="true">
            <img src="/images/bombilla-encendida-alpha.png" alt="" width="78" height="100" loading="lazy" />
          </div>
        </div>

        <div class="method__steps">
          {
            metodo.map((paso) => (
              <article class="method__step reveal">
                <span class="num">{paso.num}</span>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </article>
            ))
          }
        </div>

        <p class="method__note reveal">
          Trabajo con el método «Aprender como aprender» de L. Ronald Hubbard: me aseguro de que el
          alumno entiende de verdad, se independiza y acaba siendo capaz de estudiar por su cuenta.
        </p>
      </div>
    </section>

    <!-- ============ SOBRE CHRISTINE ============ -->
    <section class="section" id="christine">
      <div class="wrap about">
        <figure class="about__figure reveal">
          <!-- TODO(foto): retrato horizontal de Christine dando clase. -->
          <div class="frame frame--wide">
            <img src="/images/parler-francais.jpg" alt="Ilustración: «Bonjour», aprender francés" width="400" height="400" loading="lazy" />
          </div>
          <figcaption>Material de clase de Christine</figcaption>
        </figure>

        <div class="about__body reveal">
          <span class="eyebrow">Sobre mí</span>
          <h2 class="h-section">Soy Christine Dauzon</h2>

          <p style="margin-top:1.25rem;">
            Soy profesora nativa de francés y llevo la academia Komuniki desde Getafe, Madrid. Doy
            clase a particulares y a empresas, y me desplazo al domicilio o a la oficina cuando hace
            falta.
          </p>
          <p>
            También doy clases por teléfono y online. Suelen gustar porque son más flexibles y más
            cortas que una clase presencial, y encajan en cualquier agenda.
          </p>
          <p>
            Doy clase de francés y, puntualmente, de inglés, además de refuerzo escolar. Hablo
            español perfectamente, así que empezar desde cero no es problema. Lo que más me importa
            no es que apruebes un examen: es que salgas capaz de mantener una conversación y de
            defenderte tú solo.
          </p>

          <p class="about__sign">— Christine</p>

          <div class="about__marks">
            <img src="/images/belecole.jpg" alt="" width="358" height="440" loading="lazy" />
            <span>Del tablón de clase: humor, cómics y material real para practicar sin darte cuenta.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ OPINIONES ============ -->
    <section class="section section--alt" id="opiniones">
      <div class="wrap">
        <div class="testimonials__top">
          <div class="reveal">
            <span class="eyebrow">Opiniones</span>
            <h2 class="h-section">Lo que dicen alumnos y familias</h2>
          </div>

          <div class="quote-lead reveal">
            <blockquote>
              «Juan está encantado con las clases. Dice que está aprendiendo mucho y que se lo pasa
              genial. Aprende divirtiéndose.»
            </blockquote>
            <cite>
              <strong>Beatriz</strong>
              Madre de Juan, 15 años · Clases virtuales
            </cite>
          </div>
        </div>

        <div class="quote-grid">
          {
            opiniones.map((op) => (
              <figure class:list={['quote-card', 'reveal', { 'quote-card--fr': op.fr }]}>
                <p>«{op.texto}»</p>
                <footer>
                  <strong>{op.autor}</strong>
                  {op.contexto}
                </footer>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta-band">
      <div class="wrap">
        <div>
          <h2>¿Empezamos?</h2>
          <p>Cuéntame qué necesitas y te propongo cómo enfocarlo. Sin compromiso.</p>
        </div>
        <div class="hero__actions" style="margin:0;">
          <a href="#contacto" class="btn btn--ink">Escríbeme</a>
          <a
            href="https://wa.me/34622812442"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--light">WhatsApp</a
          >
        </div>
      </div>
    </section>

    <!-- ============ CONTACTO ============ -->
    <section class="section" id="contacto">
      <div class="wrap contact">
        <div class="reveal">
          <span class="eyebrow">Contacto</span>
          <h2 class="h-section">Hablamos</h2>
          <p class="lede" style="margin-top:1rem;">
            Escríbeme por donde te resulte más cómodo. Respondo yo, no un formulario automático.
          </p>

          <div class="contact__channels">
            <a class="channel" href="https://wa.me/34622812442" target="_blank" rel="noopener noreferrer">
              <span class="channel__icon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                  ><path
                    d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.24-.7.24-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.5 9.5 0 0 1-4.83-1.32l-.35-.2-3.59.94.96-3.5-.23-.36a9.44 9.44 0 0 1-1.45-5.05c0-5.22 4.27-9.47 9.51-9.47a9.46 9.46 0 0 1 9.5 9.48c0 5.22-4.27 9.47-9.5 9.47M20.5 3.49A11.8 11.8 0 0 0 12.05 0C5.5 0 .18 5.3.17 11.82c0 2.09.55 4.13 1.6 5.93L.07 24l6.4-1.67a11.9 11.9 0 0 0 5.57 1.41h.01c6.55 0 11.87-5.3 11.88-11.82a11.75 11.75 0 0 0-3.44-8.36"
                  ></path></svg
                >
              </span>
              <span>
                <span class="channel__label">WhatsApp</span>
                <span class="channel__value">Escribir ahora</span>
              </span>
            </a>

            <a class="channel" href="tel:+34622812442">
              <span class="channel__icon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                  ><path
                    d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
                  ></path></svg
                >
              </span>
              <span>
                <span class="channel__label">Teléfono</span>
                <span class="channel__value">622 81 24 42</span>
              </span>
            </a>

            <a class="channel" href="mailto:christinadauzon@gmail.com">
              <span class="channel__icon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                  ><path
                    d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.2-8 4.8-8-4.8V6l8 4.8L20 6v2.2Z"
                  ></path></svg
                >
              </span>
              <span>
                <span class="channel__label">Email</span>
                <span class="channel__value">christinadauzon@gmail.com</span>
              </span>
            </a>

            <div class="channel" style="cursor:default;">
              <span class="channel__icon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                  ><path
                    d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
                  ></path></svg
                >
              </span>
              <span>
                <span class="channel__label">Dónde</span>
                <span class="channel__value">28903 Getafe, Madrid · y online</span>
              </span>
            </div>
          </div>
        </div>

        <form class="form reveal" id="contactForm" data-to="christinadauzon@gmail.com">
          <div class="field">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="telefono">Teléfono <span class="muted">(opcional)</span></label>
            <input type="tel" id="telefono" name="telefono" autocomplete="tel" />
          </div>

          <div class="field">
            <label for="perfil">¿Para quién son las clases?</label>
            <select id="perfil" name="perfil">
              <option>Para mí</option>
              <option>Para mi hijo/a</option>
              <option>Para mi empresa</option>
            </select>
          </div>

          <div class="field">
            <label for="mensaje">¿Qué necesitas?</label>
            <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn btn--primary">Enviar mensaje</button>
          <p class="form__note">
            Se abrirá tu programa de correo con el mensaje ya escrito. ¿Prefieres no usarlo?
            <a href="https://wa.me/34622812442" target="_blank" rel="noopener noreferrer">Escríbeme por WhatsApp</a>.
          </p>
        </form>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('contactForm') as HTMLFormElement | null;

    form?.addEventListener('submit', (event) => {
      event.preventDefault();

      const value = (name: string) =>
        (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value ?? '';

      const nombre = value('nombre');
      const asunto = `Clases de idiomas — ${nombre}`;
      const cuerpo = [
        `Nombre: ${nombre}`,
        `Email: ${value('email')}`,
        value('telefono') ? `Teléfono: ${value('telefono')}` : null,
        `Para quién: ${value('perfil')}`,
        '',
        value('mensaje'),
      ]
        .filter((line) => line !== null)
        .join('\n');

      window.location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
    });
  </script>
</Landing>
