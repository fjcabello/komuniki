---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout title="Contacto" description="Contacta con Academia Komuniki. Clases de idiomas en Madrid. Tel: 622 81 24 42.">

  <div class="page-header">
    <div class="container">
      <h1>Contacto</h1>
      <p>Cualquier pregunta, estamos a tu disposición</p>
    </div>
  </div>

  <section class="section section--warm">
    <div class="container">
      <div class="grid grid--2">

        <!-- Info -->
        <div>
          <h2 style="margin-bottom:1.5rem;">Nos centramos en tu futuro</h2>
          <div class="card" style="margin-bottom:1.5rem;">
            <h3>Dirección</h3>
            <p>28903 Getafe, Madrid</p>
          </div>
          <div class="card" style="margin-bottom:1.5rem;">
            <h3>Teléfono</h3>
            <p><a href="tel:+34622812442">622 81 24 42</a></p>
          </div>
          <div class="card">
            <h3>Email</h3>
            <p><a href="mailto:christinadauzon@gmail.com">christinadauzon@gmail.com</a></p>
          </div>
        </div>

        <!-- Formulario -->
        <div>
          <h2 style="margin-bottom:1.5rem;">Escríbenos</h2>
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

</Layout>
