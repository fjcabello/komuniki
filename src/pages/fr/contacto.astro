---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout title="Contact" description="Contacte l'Académie Komuniki. Cours de langues à Madrid. Tél. : 622 81 24 42.">

  <div class="page-header">
    <div class="container">
      <h1>Contact</h1>
      <p>Pour toute question, nous sommes à ta disposition</p>
    </div>
  </div>

  <section class="section section--warm">
    <div class="container">
      <div class="grid grid--2">

        <!-- Info -->
        <div>
          <h2 style="margin-bottom:1.5rem;">Nous nous concentrons sur ton avenir</h2>
          <div class="card" style="margin-bottom:1.5rem;">
            <h3>Adresse</h3>
            <p>28903 Getafe, Madrid</p>
          </div>
          <div class="card" style="margin-bottom:1.5rem;">
            <h3>Téléphone</h3>
            <p><a href="tel:+34622812442">622 81 24 42</a></p>
          </div>
          <div class="card">
            <h3>Email</h3>
            <p><a href="mailto:christinadauzon@gmail.com">christinadauzon@gmail.com</a></p>
          </div>
        </div>

        <!-- Formulario -->
        <div>
          <h2 style="margin-bottom:1.5rem;">Écris-nous</h2>
          <ContactForm submitLabel="Envoyer" />
        </div>

      </div>
    </div>
  </section>

</Layout>
