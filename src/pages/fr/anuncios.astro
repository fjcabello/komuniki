---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Annonces" description="Offres d'emploi pour professeurs de langues à l'Académie Komuniki, Madrid.">

  <div class="page-header">
    <div class="container">
      <h1>Annonces</h1>
    </div>
  </div>

  <section class="section section--warm">
    <div class="container text-center" style="max-width:700px;">
      <div class="card">
        <h2 style="margin-bottom:1.5rem;">Tu es professeur de langues ?</h2>
        <p style="margin-bottom:1rem;">If you are a teacher and looking for classes, please contact us.</p>
        <p style="margin-bottom:1rem;">Si vous êtes professeur de français et cherchez de nouvelles classes, merci de nous contacter.</p>
        <p style="margin-bottom:2rem;">Si eres profesor y buscas nuevas clases, ponte en contacto con nosotros.</p>
        <a href="mailto:christinadauzon@gmail.com" class="btn btn--orange">christinadauzon@gmail.com</a>
      </div>
    </div>
  </section>

</Layout>
