---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Accueil" description="Academie Komuniki - Apprends les langues et communique.">
  <section class="hero">
    <div class="hero__content">
      <h1>Komuniki</h1>
      <p class="hero__subtitle">Apprends les langues et communique !</p>
      <div>
        <a href="/resultados" class="btn btn--primary">Tu veux apprendre ?</a>
        <a href="/contacto" class="btn btn--orange">Tu veux enseigner ?</a>
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container text-center">
      <h2 style="font-size:2.2rem;margin-bottom:1.2rem;">Bienvenue chez Komuniki</h2>
      <p style="max-width:760px;margin:0 auto 1rem;">
        Cette version francaise est en cours de migration depuis Wix. Le contenu complet en FR sera ajoute page par page.
      </p>
      <p style="max-width:760px;margin:0 auto 1.5rem;">
        En attendant, tu peux naviguer sur les pages principales et nous contacter pour toute information.
      </p>
      <a href="/contacto" class="btn btn--primary">Contact</a>
    </div>
  </section>
</Layout>
