---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isFr = currentPath === '/fr' || currentPath.startsWith('/fr/');

const navLinksEs = [
  { href: '/', label: 'Inicio' },
  { href: '/quienes-somos', label: 'Quiénes somos' },
  { href: '/objetivos', label: 'Objetivos' },
  { href: '/resultados', label: 'Resultados' },
  { href: '/colaboramos', label: 'Colaboramos' },
  { href: '/anuncios', label: 'Anuncios' },
  { href: '/contacto', label: 'Contacto' },
];

const navLinksFr = [
  { href: '/fr', label: 'Accueil' },
  { href: '/fr/quienes-somos', label: 'Qui sommes-nous' },
  { href: '/fr/objetivos', label: 'Objectifs' },
  { href: '/fr/resultados', label: 'Résultats' },
  { href: '/fr/colaboramos', label: 'Collaborons' },
  { href: '/fr/anuncios', label: 'Annonces' },
  { href: '/fr/contacto', label: 'Contact' },
];

const navLinks = isFr ? navLinksFr : navLinksEs;

// Derive the equivalent path in the other locale by adding/stripping the
// "/fr" prefix, since the ES and FR route trees share identical slugs.
const otherLocalePath = isFr
  ? (currentPath === '/fr' ? '/' : currentPath.replace(/^\/fr/, '') || '/')
  : (currentPath === '/' ? '/fr' : `/fr${currentPath}`);
const esHref = isFr ? otherLocalePath : currentPath;
const frHref = isFr ? currentPath : otherLocalePath;
---

<header class="site-header">
  <div class="site-header__canvas container">
    <nav class="site-nav" aria-label="Navegación principal">
      <button class="mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="site-nav__list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['site-nav__link', { active: currentPath === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/" class="site-header__logo" aria-label="Inicio Komuniki">
      <img src="/images/logo-komuniki.png" alt="Komuniki" width="258" height="258" />
    </a>

    <h1 class="site-header__title">Komuniki</h1>
    <p class="site-header__tagline">
      {isFr ? <>Apprends les langues et <span>communique</span> !</> : <>¡Aprende idiomas y <span>comunica</span>!</>}
    </p>

    <div class="site-header__lang">
      <a href={esHref} class:list={['lang-item', { active: !isFr }]} title="Español">
        <img src="https://static.parastorage.com/services/linguist-flags/1.1005.0/assets/flags/round/ESP.png" alt="Spanish" width="22" height="22" />
        <span>ES</span>
      </a>
      <a href={frHref} class:list={['lang-item', { active: isFr }]} title="Français">
        <img src="https://static.parastorage.com/services/linguist-flags/1.1005.0/assets/flags/round/FRA.png" alt="French" width="22" height="22" />
        <span>FR</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: transparent;
  }

  .site-header__canvas {
    position: relative;
    height: 320px;
    overflow: hidden;
  }

  .site-header__logo {
    position: absolute;
    left: 15px;
    top: 68px;
    display: block;
    width: 258px;
    height: 258px;
    z-index: 3;
  }

  .site-header__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-header__title {
    position: absolute;
    left: 58%;
    transform: translateX(-50%) rotate(-7deg);
    top: 72px;
    font-family: var(--font-heading);
    font-size: 74px;
    font-weight: 400;
    line-height: 1;
    color: var(--color-green);
    margin: 0;
    z-index: 2;
    letter-spacing: 1px;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .site-header__title::after {
    content: '';
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: -16px;
    height: 12px;
    background: rgba(189, 191, 55, 0.35);
  }

  .site-header__tagline {
    position: absolute;
    right: 3%;
    top: 218px;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.2vw, 40px);
    line-height: 1;
    color: #0d5d83;
    z-index: 3;
    white-space: nowrap;
  }

  .site-header__tagline span {
    color: var(--color-orange);
  }

  .site-header__lang {
    position: absolute;
    right: 10px;
    top: 82px;
    display: flex;
    gap: 0;
    align-items: center;
    z-index: 8;
    background: #efefef;
    border: 1px solid #d7d7d7;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 18px 14px;
    font-size: 16px;
    color: var(--color-brown);
    text-decoration: none;
    line-height: 1;
  }

  .lang-item + .lang-item {
    border-left: 1px solid #d7d7d7;
  }

  .lang-item img {
    display: block;
  }

  .lang-item.active span {
    font-weight: 700;
  }

  .site-nav {
    position: absolute;
    top: 28px;
    left: 58%;
    transform: translateX(-50%);
    background: var(--color-brown);
    z-index: 5;
    white-space: nowrap;
  }

  .site-nav__list {
    display: flex;
    gap: 0;
    list-style: none;
    justify-content: center;
  }

  .site-nav__link {
    display: block;
    padding: 0.05rem 0.34rem;
    font-family: var(--font-nav);
    font-size: 24px;
    line-height: 1;
    font-weight: 700;
    color: var(--color-white);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
  }

  .site-nav__link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-peach);
  }

  .site-nav__link.active {
    border-bottom-color: #ffffff;
    color: var(--color-white);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.75rem;
  }

  .mobile-toggle span {
    display: block;
    width: 26px;
    height: 3px;
    background: var(--color-white);
    transition: transform 0.3s;
  }

  @media (max-width: 900px) {
    .site-header__canvas {
      height: 150px;
      overflow: visible;
    }

    .site-header__logo {
      left: 16px;
      top: 52px;
      width: 86px;
      height: 86px;
    }

    .site-header__title {
      top: 68px;
      left: 124px;
      transform: none;
      font-size: 44px;
      color: var(--color-orange);
    }

    .site-header__title::after {
      display: none;
    }

    .site-header__tagline {
      display: none;
    }

    .site-header__lang {
      right: 16px;
      top: 62px;
      background: transparent;
      border: none;
      box-shadow: none;
      gap: 0.3rem;
    }

    .mobile-toggle {
      display: flex;
      position: static;
      margin-left: auto;
    }

    .site-nav {
      top: 16px;
      left: 16px;
      right: 16px;
      transform: none;
      display: flex;
      align-items: center;
      min-height: 38px;
      padding: 0 0.35rem;
    }

    .site-nav__list {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-brown);
      z-index: 99;
      padding: 1rem 0;
    }

    .site-nav__list.open {
      display: flex;
    }

    .site-nav__link {
      text-align: center;
      padding: 0.75rem 1.5rem;
      font-size: 34px;
      border-bottom: none;
    }

    .site-nav__link.active {
      background: rgba(255, 255, 255, 0.1);
      border-bottom: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.mobile-toggle');
  const navList = document.querySelector('.site-nav__list');

  toggle?.addEventListener('click', () => {
    const isOpen = navList?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
