---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Social icons bar -->
  <div class="footer-social">
    <a href="https://www.facebook.com/AprendeIdiomasYComunica/?ref=1" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
    <a href="https://www.linkedin.com/in/christine-dauzon-7a071266/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.854 0-2.137 1.445-2.137 2.94v5.666H9.35V9h3.414v1.561h.049c.477-.9 1.637-1.85 3.369-1.85 3.601 0 4.266 2.369 4.266 5.455v6.286zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>
  </div>

  <!-- Green footer strip -->
  <div class="footer-green">
    <div class="container">
      <p>&copy; {year} por Komuniki. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 0;
    background: var(--color-sand);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-brown);
    color: var(--color-white);
    transition: background 0.2s;
  }

  .social-icon:hover {
    background: var(--color-orange);
    color: var(--color-white);
  }

  .footer-green {
    background: var(--color-green);
    padding: 1.5rem 0;
    text-align: center;
  }

  .footer-green p {
    font-size: 0.9rem;
    color: var(--color-brown);
    font-family: var(--font-body);
  }
</style>
