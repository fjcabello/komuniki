---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Social icons bar -->
  <div class="footer-social">
    <a href="https://www.facebook.com/academiakomuniki" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
  </div>

  <!-- Green footer strip -->
  <div class="footer-green">
    <div class="container">
      <p>&copy; {year} por Komuniki. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 0;
    background: var(--color-sand);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-brown);
    color: var(--color-white);
    transition: background 0.2s;
  }

  .social-icon:hover {
    background: var(--color-orange);
    color: var(--color-white);
  }

  .footer-green {
    background: var(--color-green);
    padding: 1.5rem 0;
    text-align: center;
  }

  .footer-green p {
    font-size: 0.9rem;
    color: var(--color-brown);
    font-family: var(--font-body);
  }
</style>
